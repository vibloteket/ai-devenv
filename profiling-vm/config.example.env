# Copy to config.env and adjust locally. config.env is ignored by Git.
VM_NAME=munk2d-profiler
VM_MEMORY_MB=4096
VM_VCPUS=2
VM_DISK_GB=30
VM_NETWORK=default
VM_IP=192.168.122.10
VM_MAC=52:54:00:6d:75:6e
VM_CPUSET=8,10
VM_USER=benchmark

# Public key only. Never put the private key in this repository.
SSH_PUBLIC_KEY_FILE=/home/vb/.ssh/munk2d-profiler.pub

IMAGE_URL=https://cloud.debian.org/images/cloud/trixie/20260810-2566/debian-13-generic-amd64-20260810-2566.qcow2
IMAGE_SHA512=f6978100d8031c266d55d7815ceea7fcdeacf28e1e5834fdb9c94ac96880a054a6e6f8681c2d3b0584e0057eaf3ef7353856b85212d04134744faa9b3bb1f24f
IMAGE_DIR=/var/lib/libvirt/images/munk2d-profiler

IDLE_MINUTES=30
MAX_RUNTIME_HOURS=6
